{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "mobile-document-capability",
  "description": "Least-privilege Android/iOS permissions for picker-selected Markdown, backup, export files, safe external URLs, lifecycle events, and queued open-with URLs.",
  "windows": ["main"],
  "platforms": ["iOS", "android"],
  "permissions": [
    "core:event:default",
    "mobile-lifecycle-commands",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-stat",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "opener:allow-default-urls"
  ]
}
