{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Markora"
      }
    ]
  },
  "bundle": {
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mkdn"],
        "mimeType": "text/markdown",
        "name": "Markdown document",
        "role": "Editor",
        "androidIntentActionFilters": ["View", "Send", "SendMultiple"]
      },
      {
        "ext": ["txt"],
        "mimeType": "text/plain",
        "name": "Text document",
        "role": "Editor",
        "androidIntentActionFilters": ["View", "Send", "SendMultiple"]
      }
    ],
    "android": {
      "minSdkVersion": 24
    }
  }
}
